  "queries": [
    {
      "id": "bb85e98e-f549-5cc1-ac42-8e41046bd9b1",
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "c828be47-aa72-4fc6-bc74-7d24110b1f93"
      },
      "text": "ReturnsGoldLatest() | distinct country | order by country asc",
      "usedVariables": []
    },
    {
      "id": "55de6344-e01f-5458-b19b-4aa985faf0a5",
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "c828be47-aa72-4fc6-bc74-7d24110b1f93"
      },
      "text": "let Rates = datatable(Currency:string, RatePerCUHour:decimal, CheckedAt:datetime)[\n\"USD\", 0.2, datetime(2026-11-04T17:25:04.332318+00:00),\n\"INR\", 19.04575, datetime(2026-11-04T17:38:05.868483+00:00)\n];\nlet SelectedRate = toscalar(Rates | where Currency == _billingCurrency | project RatePerCUHour);\nlet CapacityUnits = toint(substring(_capacitySku, 1));\nlet ValidInputs = _chargedHours between (0 .. 24) and _capacitySku in (\"F2\", \"F4\", \"F8\", \"F16\", \"F32\", \"F64\", \"F128\", \"F256\", \"F512\");\ndatatable(SortOrder:int, Period:string, Days:int)[\n1, \"1 day\", 1,\n2, \"1 week (7 days)\", 7,\n3, \"1 month (30 days)\", 30,\n4, \"1 year (365 days)\", 365]\n| extend Currency=_billingCurrency,\n    EstimatedCost=iff(ValidInputs, toreal(tolong(SelectedRate * CapacityUnits * _chargedHours * Days * decimal(100) + decimal(0.5))) / 100.0, real(null))\n| order by SortOrder asc\n| project Period, Currency, EstimatedCost",
      "usedVariables": [
        "_capacitySku",
        "_billingCurrency",
        "_chargedHours"
      ]
    },
    {
      "id": "a173c756-7c01-4c09-96e7-6f75e9cc941a",
      "text": "let GoldCases = ReturnsGoldLatest()\n| where return_registered_at between (_startTime .. _endTime)\n| where isempty(_countries) or country in (_countries);\nGoldCases | summarize ReturnCases=count()",
      "usedVariables": [
        "_countries",
        "_startTime",
        "_endTime"
      ],
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "c828be47-aa72-4fc6-bc74-7d24110b1f93"
      }
    },
    {
      "id": "fd1f8deb-900a-4e02-b460-1a89d2380a24",
      "text": "let GoldCases = ReturnsGoldLatest()\n| where return_registered_at between (_startTime .. _endTime)\n| where isempty(_countries) or country in (_countries);\nGoldCases | summarize UnknownOrigins=countif(originator_type == 'Unknown' or isempty(originator_id))",
      "usedVariables": [
        "_countries",
        "_startTime",
        "_endTime"
      ],
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "c828be47-aa72-4fc6-bc74-7d24110b1f93"
      }
    },
    {
      "id": "8b990a96-32e5-5595-be97-0be5ad6d8eb0",
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "c828be47-aa72-4fc6-bc74-7d24110b1f93"
      },
      "text": "let GoldCases = ReturnsGoldLatest()\n| where return_registered_at between (_startTime .. _endTime)\n| where isempty(_countries) or country in (_countries);\nGoldCases | summarize DistinctBatteries=count_distinct(battery_serial)",
      "usedVariables": [
        "_countries",
        "_startTime",
        "_endTime"
      ]
    },
    {
      "id": "25f1a2a3-adf9-5cd4-9e71-a5c612b578bb",
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "c828be47-aa72-4fc6-bc74-7d24110b1f93"
      },
      "text": "ReturnsGoldCommits | where data_label == 'SYNTHETIC' | top 1 by published_at desc | project ReplaysRemoved=replays_removed",
      "usedVariables": []
    },
    {
      "id": "cb0f0eee-63dd-45c5-af4e-4a0c59a82fa2",
      "text": "let GoldCases = ReturnsGoldLatest()\n| where return_registered_at between (_startTime .. _endTime)\n| where isempty(_countries) or country in (_countries);\nGoldCases | summarize ReturnCases=count() by originator_type | order by ReturnCases desc",
      "usedVariables": [
        "_countries",
        "_startTime",
        "_endTime"
      ],
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "c828be47-aa72-4fc6-bc74-7d24110b1f93"
      }
    },
    {
      "id": "a284f113-2f3a-440d-a503-5abeea7f8581",
      "text": "let GoldCases = ReturnsGoldLatest()\n| where return_registered_at between (_startTime .. _endTime)\n| where isempty(_countries) or country in (_countries);\nGoldCases | summarize ReturnCases=count() by reported_reason | order by ReturnCases desc",
      "usedVariables": [
        "_countries",
        "_startTime",
        "_endTime"
      ],
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "c828be47-aa72-4fc6-bc74-7d24110b1f93"
      }
    },
    {
      "id": "ca440da5-7397-4123-88ee-5c76bc226cd4",
      "text": "let GoldCases = ReturnsGoldLatest()\n| where return_registered_at between (_startTime .. _endTime)\n| where isempty(_countries) or country in (_countries);\nGoldCases | summarize ReturnCases=count() by inspection_finding | order by ReturnCases desc",
      "usedVariables": [
        "_countries",
        "_startTime",
        "_endTime"
      ],
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "c828be47-aa72-4fc6-bc74-7d24110b1f93"
      }
    },
    {
      "id": "28041b15-0e1d-53f3-ae0d-11929ffbf870",
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "c828be47-aa72-4fc6-bc74-7d24110b1f93"
      },
      "text": "let GoldCases = ReturnsGoldLatest()\n| where return_registered_at between (_startTime .. _endTime)\n| where isempty(_countries) or country in (_countries);\nGoldCases | summarize ReturnCases=count() by RegistrationMonth=startofmonth(return_registered_at) | order by RegistrationMonth asc",
      "usedVariables": [
        "_countries",
        "_startTime",
        "_endTime"
      ]
    },
    {
      "id": "55261795-b145-4df2-99d6-1ecc59daf3ed",
      "text": "let GoldCases = ReturnsGoldLatest()\n| where return_registered_at between (_startTime .. _endTime)\n| where isempty(_countries) or country in (_countries);\nGoldCases\n| summarize ReturnCases=count(), DistinctBatteries=count_distinct(battery_serial),\n    FirstReturn=min(return_registered_at), LastReturn=max(return_registered_at) by batch_id, product_id\n| order by ReturnCases desc, batch_id asc",
      "usedVariables": [
        "_countries",
        "_startTime",
        "_endTime"
      ],
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "c828be47-aa72-4fc6-bc74-7d24110b1f93"
      }
    },
    {
      "id": "766b6468-01ef-48bb-8d95-01b5b901f5bc",
      "text": "let GoldCases = ReturnsGoldLatest()\n| where return_registered_at between (_startTime .. _endTime)\n| where isempty(_countries) or country in (_countries);\nGoldCases\n| project return_id, battery_serial, product_id, batch_id, country, originator_type, originator_id,\n    submitted_by_type, submitted_by_id, receiving_warehouse_id, reported_reason, inspection_finding,\n    return_status, revision, return_registered_at, warranty_status, resolution_action\n| order by return_registered_at desc, return_id desc",
      "usedVariables": [
        "_countries",
        "_startTime",
        "_endTime"
      ],
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "c828be47-aa72-4fc6-bc74-7d24110b1f93"
      }
    },
    {
      "id": "d7a61524-e4e8-4804-a580-e46bb20dc846",
      "text": "let Coverage = ReturnsGoldLatest()\n| summarize ReturnCases=count(), FirstReturn=min(return_registered_at), LastReturn=max(return_registered_at)\n| extend JoinKey=1;\nReturnsGoldCommits\n| where data_label == \"SYNTHETIC\"\n| top 1 by published_at desc\n| extend JoinKey=1\n| join kind=inner Coverage on JoinKey\n| project ReturnCases, FirstReturn, LastReturn,\n    BronzeEvents=bronze_events, QuarantinedEvents=quarantined_events,\n    ValidRawEvents=valid_raw_events, SilverEvents=silver_events,\n    ReplayRows=replays_removed, GoldCases=gold_cases, PublishedByRunId=pipeline_run_id",
      "usedVariables": [],
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "c828be47-aa72-4fc6-bc74-7d24110b1f93"
      }
    }
  ],
