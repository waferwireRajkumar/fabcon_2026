.create-merge table ReturnsGoldRaw (
    data_label:string,
    demo_run_id:string,
    event_id:string,
    event_time:datetime,
    event_type:string,
    revision:long,
    return_id:string,
    return_registered_at:datetime,
    battery_serial:string,
    product_id:string,
    batch_id:string,
    shipment_id:string,
    originator_type:string,
    originator_id:string,
    submitted_by_type:string,
    submitted_by_id:string,
    receiving_warehouse_id:string,
    country:string,
    reported_reason:string,
    inspection_finding:string,
    return_status:string,
    product_name:string,
    battery_technology:string,
    warranty_months:long,
    factory_id:string,
    distributor_id:string,
    retailer_id:string,
    manufactured_at:datetime,
    shipped_at:datetime,
    delivered_at:datetime,
    invoice_at:datetime,
    warranty_expires_at:datetime,
    warranty_status:string,
    resolution_action:string,
    publish_id:string
)

.create-merge table ReturnsGoldCommits (
    publish_id:string,
    published_at:datetime,
    data_label:string,
    dataset_id:string,
    bronze_events:long,
    quarantined_events:long,
    valid_raw_events:long,
    silver_events:long,
    replays_removed:long,
    gold_cases:long,
    gold_sha256:string,
    pipeline_run_id:string,
    source_manifest_sha256:string
)
